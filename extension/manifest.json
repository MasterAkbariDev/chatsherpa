{
  "manifest_version": 3,
  "name": "ChatSherpa Connector",
  "version": "0.1.5",
  "description": "Capture your signed-in AI provider session and send it to your ChatSherpa server.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["cookies", "scripting"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.deepseek.com/*",
    "https://grok.com/*",
    "https://*.grok.com/*",
    "https://gemini.google.com/*",
    "https://*.google.com/*",
    "http://localhost/*",
    "https://*/*"
  ],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": [
        "http://*/connect/*",
        "https://*/connect/*",
        "http://*/*/connect/*",
        "https://*/*/connect/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ChatSherpa Connector",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
