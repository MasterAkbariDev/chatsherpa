[Unit]
Description=ChatSherpa live-view and connect login server
After=network-online.target
Wants=network-online.target

StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=chatsherpa
Group=chatsherpa
WorkingDirectory=/opt/chatsherpa
Environment=HOME=/opt/chatsherpa
ExecStart=/opt/chatsherpa/.venv/bin/chatsherpa serve
Restart=on-failure
RestartSec=30
MemoryMax=350M
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/chatsherpa/sessions
# Playwright creates its profile and artifact folders under /tmp, which is read-only
# under ProtectSystem=strict. A private /tmp gives the browser a writable one.
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
