# Copy this file to `.env` and fill in the values you have.
# `.env` is git-ignored so your credentials never get committed.
#
# You generally only need the SESSION path per provider (created by
# `chatsherpa login <provider>` — a browser window opens and YOU type the
# password). EMAIL/PASSWORD are optional and only used by the experimental
# `--auto` login that you run yourself; see README for why headful capture
# is the reliable path.

# ---------------- ChatGPT ----------------
CHATGPT_SESSION=sessions/chatgpt.json
CHATGPT_EMAIL=
CHATGPT_PASSWORD=

# ---------------- DeepSeek ----------------
DEEPSEEK_SESSION=sessions/deepseek.json
DEEPSEEK_EMAIL=
DEEPSEEK_PASSWORD=

# ---------------- Grok ----------------
GROK_SESSION=sessions/grok.json
GROK_EMAIL=
GROK_PASSWORD=

# ---------------- Gemini ----------------
GEMINI_SESSION=sessions/gemini.json
GEMINI_EMAIL=
GEMINI_PASSWORD=

# Global defaults (optional)
CHATSHERPA_HEADLESS=true
CHATSHERPA_RESPONSE_TIMEOUT_S=180
