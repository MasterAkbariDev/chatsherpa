# Copy to .env and fill in. .env is git-ignored. `make setup` creates it for you.

# ---------- login server (only for `chatsherpa serve`) ----------
PUBLIC_BASE_URL=https://bv.akbaridev.com/chatsherpa
SERVER_HOST=127.0.0.1
SERVER_PORT=8080
# Shared secret your bot sends in the X-ChatSherpa-Secret header.
API_SECRET=
# Fernet key: encrypts stored sessions at rest. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=
# Optional: errors and events POSTed (HMAC-signed) to your endpoint.
WEBHOOK_URL=
WEBHOOK_SECRET=

# ---------- session files (created by login / grab / import) ----------
CHATGPT_SESSION=sessions/chatgpt.json
DEEPSEEK_SESSION=sessions/deepseek.json
GROK_SESSION=sessions/grok.json
GEMINI_SESSION=sessions/gemini.json

# ---------- Telegram bot (only for the bot examples) ----------
BOT_TOKEN=
